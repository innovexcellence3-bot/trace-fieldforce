# ---------------------------------------------------------------------------
#  TRACE - setting lokal. setup.bat menyalin file ini menjadi .env (sekali).
#  Edit .env (bukan file ini) bila username / warehouse berbeda per laptop.
# ---------------------------------------------------------------------------

# Port aplikasi (http://localhost:8020)
TRACE_PORT=8020

# Snowflake - login SSO lewat browser (authenticator externalbrowser)
SNOWFLAKE_ACCOUNT=pmi-pmi_id
SNOWFLAKE_HOST=pmi-pmi_id.snowflakecomputing.com
SNOWFLAKE_USER=mmahendr@PMINTL.NET
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_DATABASE=DB_ID_PRD
SNOWFLAKE_WAREHOUSE=WH_ID_COMMERCIAL_DA
# Opsional - kosongkan bila memakai default role user
SNOWFLAKE_ROLE=
