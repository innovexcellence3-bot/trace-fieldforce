{
  "name": "trace-fieldforce",
  "private": true,
  "version": "2.0.0",
  "description": "TRACE - Field Force Location Intelligence (Node.js server + Vite UI, Snowflake query + CSV cache)",
  "type": "module",
  "scripts": {
    "setup": "npm install",
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch-path=server server/index.js\" \"vite\"",
    "dev:api": "node --watch-path=server server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.22.3",
    "snowflake-sdk": "^3.4.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "chart.js": "^4.6.1",
    "concurrently": "^10.0.6",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "vite": "^6.4.5"
  }
}
